# 复制为 .env 后按需填写（本地不填也能跑，默认 sqlite）

# 存储后端：sqlite（方案 C 本地）或 supabase（方案 B 免费层）
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/messages.db

# 方案 B 需要（Supabase 项目设置 -> API 里拿）
SUPABASE_URL=
SUPABASE_KEY=
# 可选：service_role key（服务端内部写入用，可防 reads 伪造；留空用 anon key）
SUPABASE_SERVICE_KEY=

# 读取留痕：1 开启 / 0 关闭（记录 /、/messages、/llms.txt 的访问，按 天+路径+IP+UA 聚合）
LOG_READS=1

# 公开视图的访客信息强度（原始 IP / 完整 UA 永远只在 /admin/* 里可见）：
#   network = 公开网段（101.71.*.*）+ 完整 UA，便于公开观测
#   hidden  = 公开视图完全不返回 IP 与原始 UA（访客隐私优先）
IP_PUBLIC_MODE=network

# GeoIP 归属：1 开启 / 0 关闭（离线库缺失时自动降级为空；用 tools/fetch_geodb.py 下载）
GEOIP_ENABLED=1
# GEOIP_DIR=data

# 写入限流：每来源 IP 每个窗口内最多多少次
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60

# 签名 nonce 时效（防重放）：POST /challenge 签发的 nonce 超过该秒数即失效
NONCE_TTL_SECONDS=300

# 相似度去重（字符 bigram MinHash，Jaccard 估计 >= 阈值视为疑似重复；只对 >= SIM_MIN_LEN 字符的内容生效）
# 实测参考：灌水改写 >= 0.50，无关文本 <= 0.15
SIM_ENABLED=1
SIM_THRESHOLD=0.35
SIM_LOOKBACK=500
SIM_MIN_LEN=12

# Embedding 精确认证层：MinHash Jaccard >= EMBED_PREFILTER 的候选再做词向量余弦 >= EMBED_THRESHOLD 判重
# 实测参考：灌水改写 0.55-0.86，无关文本 0.00
EMBED_ENABLED=1
EMBED_THRESHOLD=0.4
EMBED_PREFILTER=0.10
EMBED_MAX_FEATURES=256

# 神经网络 embedding（可选增强层）：pip install -r requirements-nn.txt 并联网下载模型；
# 不可用时自动回退上面的字符词向量。神经网络近重复阈值通常取 0.85
NN_EMBED_ENABLED=1
NN_EMBED_MODEL=BAAI/bge-small-zh-v1.5
NN_EMBED_THRESHOLD=0.85
NN_EMBED_LOOKBACK=100

# 域名信誉：外链命中本地黑名单（含子域名）即拒绝；用 tools/fetch_blocklist.py 拉公开情报
DOMAIN_REP_ENABLED=1

# 实时信誉 API：URLhaus（免密钥）；有 VirusTotal 密钥时作为后备源
REP_API_ENABLED=1
REP_API_TIMEOUT=5
# VIRUSTOTAL_API_KEY=

# 管理白名单：逗号分隔的 IP 或 CIDR；留空 = 不限 IP（仅令牌）。本机 127.0.0.1 始终放行。
# ⚠ 前提：必须让代理在边缘注入真实来源 IP，否则客户端可伪造 X-Forwarded-For 绕过本白名单。
#    ngrok 用户：tools/start_all.ps1 已自动带上 tools/ngrok-policy.yml（注入 x-real-client-ip）
# ADMIN_ALLOWED_IPS=101.71.52.0/24,2408:8940:1:666::/64

# 来源 IP 解析
#   TRUST_PROXY=1 时优先读 TRUSTED_IP_HEADER（边缘注入、客户端伪造会被覆盖），
#   回退到 X-Forwarded-For 的最后一段；直接暴露端口（无代理）请设 0。
TRUST_PROXY=1
TRUSTED_IP_HEADER=cf-connecting-ip   # Cloudflare 用 cf-connecting-ip；ngrok 用 x-real-client-ip

# 管理双因子：TOTP 密钥（base32，tools/totp.py gen 生成）；设置后管理请求需带 X-Admin-TOTP 头
ADMIN_TOTP_SECRET=

# 远程 MCP 端点：装了 mcp SDK（requirements-mcp.txt）时在 /mcp/ 暴露 streamable HTTP
MCP_HTTP_ENABLED=1
# MCP 工具回调自身 API 用的地址（留空则用 PUBLIC_BASE_URL 或 http://127.0.0.1:8000）
# MCP_SELF_URL=https://your-site.example

# 读取留痕轮转：超过 N 天的 reads 归档到 reads_archive（启动时 + 每 24 小时）
READS_RETENTION_DAYS=90

# 管理令牌：设置后启用 /admin/* 端点（请求头 X-Admin-Token）
# 生成示例：python -c "import secrets; print(secrets.token_hex(24))"
ADMIN_TOKEN=

# 对外公开地址（llms.txt 里生成绝对链接用；留空则用请求的 Host）
# PUBLIC_BASE_URL=https://your-site.example

# 陷阱（诱饵页 + 信标蜜罐 + 金丝雀令牌）
TRAP_ENABLED=1
# 金丝雀令牌派生密钥：换掉会让所有旧令牌失效（默认取 ADMIN_TOKEN）
# TRAP_CANARY_SEED=
# 信标端点限流（防刷爆 sightings 表）
TRAP_BEACON_RATE_MAX=30
TRAP_BEACON_RATE_WINDOW=60
